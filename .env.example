# Supabase browser configuration. The anon key is public; enforce access with RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SAGE_API_URL=https://resellers.accounting.sageone.co.za/api/2.0.0
SAGE_API_KEY=
SAGE_USERNAME=
SAGE_PASSWORD=
SAGE_COMPANY_ID=
SAGE_MODE=demo
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3005/api/auth/sage/callback

# Prospect intelligence providers (server-side only).
DISCOVERY_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY=
CRAWLER_USER_AGENT=OfficeCoProspectIntelligence/1.0

# Payment provider public key; use a production key only for live payments.
VITE_PAYSTACK_PUBLIC_KEY=
